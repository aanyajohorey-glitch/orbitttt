# Example secrets for ORBIT. Copy this file to .streamlit/secrets.toml (locally)
# or paste the lines into "App settings -> Secrets" on Streamlit Community Cloud.
# NEVER commit the real secrets.toml: it is listed in .gitignore.
#
# Both lines are optional. Without a key, ORBIT writes replies with its own
# templates (or with Ollama, if it is installed on this computer).

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: which Claude model writes the replies. The default is claude-opus-5-5.
# A cheaper and faster choice for short replies is claude-haiku-5-5.
# ORBIT_CLOUD_MODEL = "claude-haiku-5-5"
