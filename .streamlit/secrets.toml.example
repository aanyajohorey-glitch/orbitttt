# Example secrets for ORBIT. Copy this file to .streamlit/secrets.toml (locally)
# or paste the lines into "App settings -> Secrets" on Streamlit Community Cloud.
# NEVER commit the real secrets.toml: it is listed in .gitignore.
#
# Both lines are optional. Without a key, ORBIT writes replies with its own
# templates (or with Ollama, if it is installed on this computer).

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: which Claude model writes the replies. The default is claude-opus-5-5.
# A cheaper and faster choice for short replies is claude-haiku-5-5.
# ORBIT_CLOUD_MODEL = "claude-haiku-5-5"

# Create Mode: free online images, music and fonts. All optional, all free, no billing.
# Without a key, that source is skipped and ORBIT uses its own resources instead.
# UNSPLASH_ACCESS_KEY = "..."      # unsplash.com/developers -> New Application -> Access Key
# PIXABAY_API_KEY = "..."          # pixabay.com/api/docs (shown when logged in)
# LASTFM_API_KEY = "..."           # last.fm/api/account/create (non-commercial)
# GOOGLE_FONTS_API_KEY = "..."     # Google Cloud -> enable "Web Fonts Developer API" -> API key (no billing)
# OPENVERSE_CLIENT_ID = "..."      # optional: free Openverse registration for a higher limit
# OPENVERSE_CLIENT_SECRET = "..."
